  updatedAt        DateTime       @updatedAt

  createdBy      User?             @relation("BusinessCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  industry       Industry?         @relation(fields: [industryId], references: [id], onDelete: SetNull)
  snapshot       Snapshot?         @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  defaultChatbot Chatbot?          @relation("BusinessDefaultChatbot", fields: [defaultChatbotId], references: [id], onDelete: SetNull)
  lifecyclePipeline      Pipeline?      @relation("BusinessLifecyclePipeline", fields: [lifecyclePipelineId], references: [id], onDelete: SetNull)
