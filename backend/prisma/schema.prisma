model ProductOption {
  id         String    @id @default(uuid())
  businessId String
  productId  String
  name       String
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  values   ProductOptionValue[]

  @@index([businessId, productId])
  @@map("product_options")
}

model ProductOptionValue {
  id         String    @id @default(uuid())
  businessId String
  optionId   String
  value      String
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  option   ProductOption             @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantLinks ProductVariantOptionValue[]

  @@index([businessId, optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id              String              @id @default(uuid())
  businessId      String
  productId       String
  variantKey      String
  sku             String?
  barcode         String?
  price           Decimal?            @db.Decimal(12, 2)
  compareAtPrice  Decimal?            @db.Decimal(12, 2)
  purchaseCost    Decimal?            @db.Decimal(12, 2)
  stockQuantity   Int                 @default(0)
  desiredQuantity Int?
  status          ProductVariantStatus @default(ACTIVE)
  customAttributes Json?
  featuredImageKey String?
  featuredImageMimeType String?
  featuredImageWidth Int?
  featuredImageHeight Int?
  sortOrder       Int                 @default(0)
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues ProductVariantOptionValue[]
  inventoryAdjustments ProductInventoryAdjustment[]
  serviceProductUsages ServiceProductUsage[]
  invoiceItems InvoiceItem[]
  bundleItemsAsComponent ProductBundleItem[] @relation("BundleComponentVariant")

  @@unique([productId, variantKey])
  @@index([businessId, productId])
  @@index([businessId, sku])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  id            String @id @default(uuid())
  businessId    String
  variantId     String
  optionValueId String

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([businessId, variantId])
  @@index([businessId, optionValueId])
  @@map("product_variant_option_values")
}

model ProductBundleItem {
  id                  String  @id @default(uuid())
  businessId          String
  bundleProductId     String
  componentProductId  String
  componentVariantId  String?
  quantity            Int     @default(1)

  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bundleProduct    Product         @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProduct Product         @relation("BundleComponentProduct", fields: [componentProductId], references: [id], onDelete: Restrict)
  componentVariant ProductVariant? @relation("BundleComponentVariant", fields: [componentVariantId], references: [id], onDelete: SetNull)

  @@index([businessId, bundleProductId])
  @@map("product_bundle_items")
}

model ProductImage {
  id          String    @id @default(uuid())
  businessId  String
  productId   String
  storageKey  String
  mimeType    String
  width       Int
  height      Int
  altText     String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, productId])
  @@map("product_images")
}

model ProductInventoryAdjustment {
  id             String                       @id @default(uuid())
  businessId     String
  productId      String
  variantId      String?
  type           ProductInventoryAdjustmentType
  quantityChange Int
  note           String?
  actorUserId    String?
  checkoutId     String?
  invoiceItemId  String?
  appointmentId  String?
  serviceId      String?
  createdAt      DateTime                     @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  actor    User?           @relation("ProductInventoryAdjustmentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, productId])
  @@index([businessId, variantId])
  @@index([businessId, createdAt])
  @@map("product_inventory_adjustments")
}

model Lead {
  id              String     @id @default(uuid())
  businessId      String
  contactId       String?
  serviceId       String?
  pipelineId      String
  pipelineStageId String
  assignedToId    String?
  title           String?
  value           Decimal?   @db.Decimal(12, 2)
  status          LeadStatus @default(ACTIVE)
  source          String?
  notes           String?
  createdById     String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)
  assignedTo    User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([businessId, contactId])
  @@index([businessId])
  @@index([businessId, pipelineId])
  @@index([businessId, pipelineStageId])
  @@index([businessId, assignedToId])
  workItems   WorkItem[]
  linkedNotes Note[] @relation("LeadNotes")
  linkedTasks Task[] @relation("LeadTasks")

  @@index([businessId, serviceId])
  @@map("leads")
}

model Note {
  id              String    @id @default(uuid())
  businessId      String
  contactId       String?
  leadId          String?
  title           String
  description     String    @default("")
  descriptionText String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead      Lead?    @relation("LeadNotes", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("NoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, contactId])
  @@index([businessId, leadId])
  @@index([businessId, createdAt])
  @@map("notes")
}

model Task {
  id              String        @id @default(uuid())
  businessId      String
  contactId       String?
  leadId          String?
  title           String
  description     String        @default("")
  descriptionText String?
  dueAt           DateTime
  status          TaskStatus    @default(TODO)
  priority        TaskPriority?
  assignedToId    String?
  createdById     String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       Lead?    @relation("LeadTasks", fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, contactId])
  @@index([businessId, leadId])
  @@index([businessId, status])
  @@index([businessId, assignedToId])
  @@index([businessId, dueAt])
  @@map("tasks")
}

model TimeCard {
  id           String    @id @default(uuid())
  businessId   String
  userId       String
  clockInTime  DateTime
  clockOutTime DateTime?
  paidMinutes  Int?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, userId])
  @@index([businessId, clockInTime(sort: Desc)])
  @@map("time_cards")
}

model WorkItem {
  id            String         @id @default(uuid())
  businessId    String
  contactId     String
  serviceId     String?
  leadId        String?
  title         String
  type          String?
  status        WorkItemStatus @default(DRAFT)
  description   String?
  scheduledAt   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  amount        Decimal?       @db.Decimal(12, 2)
  assignedToId  String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo User?    @relation("WorkItemAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("WorkItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  estimates    Estimate[]
  invoices     Invoice[]
  appointments Appointment[]

  @@index([businessId])
  @@index([businessId, contactId])
  @@index([businessId, serviceId])
  @@index([businessId, status])
  @@index([businessId, assignedToId])
  @@index([businessId, scheduledAt])
  @@map("work_items")
}

model Estimate {
  id             String         @id @default(uuid())
  businessId     String
  contactId      String
  workItemId     String?
  estimateNumber String
  status         EstimateStatus @default(DRAFT)
  issueDate      DateTime
  expiryDate     DateTime?
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal        @default(0) @db.Decimal(12, 2)
  notes              String?
  termsAndConditions String?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact   Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  workItem  WorkItem?      @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("EstimateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     EstimateItem[]
  invoices  Invoice[]

  @@unique([businessId, estimateNumber])
  @@index([businessId])
  @@index([businessId, contactId])
  @@index([businessId, status])
  @@index([businessId, issueDate])
  @@map("estimates")
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  serviceId   String?
  title       String
  description String?
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([estimateId])
  @@map("estimate_items")
}

model Invoice {
  id            String        @id @default(uuid())
  businessId    String
  contactId     String
  estimateId    String?
  workItemId    String?
  appointmentId String?
  invoiceNumber String
  kind          InvoiceKind   @default(STANDARD)
  displaySequence Int?
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal       @default(0) @db.Decimal(12, 2)
  publicToken            String        @unique
  publicUrl              String?
  paymentStatus          InvoicePaymentStatus @default(UNPAID)
  paidAmount             Decimal       @default(0) @db.Decimal(12, 2)
  remainingAmount        Decimal       @default(0) @db.Decimal(12, 2)
  lastPaymentAt          DateTime?
  stripeCheckoutUrl      String?
  stripePaymentLinkId    String?
  notes              String?
  paymentTerms       String?
  termsAndConditions String?
  metadata           Json?
  closedAt           DateTime?
  closedById         String?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact   Contact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  estimate  Estimate?     @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  workItem  WorkItem?     @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  closedBy  User?         @relation("InvoiceClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]
  walletTransactions ContactWalletTransaction[]
  giftCards          GiftCard[]
  clientPackages     ClientPackage[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, contactId])
  @@index([businessId, estimateId])
  @@index([businessId, appointmentId])
  @@index([businessId, status])
  @@index([businessId, kind])
  @@index([businessId, kind, status])
  @@index([businessId, issueDate])
  @@index([publicToken])
  @@map("invoices")
}

model InvoiceItem {
  id          String           @id @default(uuid())
  invoiceId   String
  lineType    InvoiceLineType  @default(SERVICE)
  serviceId   String?
  productId   String?
  variantId   String?
  staffUserId String?
  title       String
  description String?
  quantity    Decimal          @db.Decimal(12, 4)
  unitPrice   Decimal          @db.Decimal(12, 2)
  totalPrice  Decimal          @db.Decimal(12, 2)
  sortOrder   Int              @default(0)
  metadata    Json?
  createdAt   DateTime         @default(now())

  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service   Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  staffUser User?           @relation("InvoiceItemStaff", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
  @@index([variantId])
  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(uuid())
  businessId  String
  invoiceId   String
  contactId   String
  payableType PayableType   @default(INVOICE)
  payableId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  status      PaymentStatus @default(SUCCEEDED)
  provider              PaymentProvider @default(MANUAL)
  providerMetadata      Json?
  stripePaymentIntentId String? @unique
  stripeCheckoutSessionId String? @unique
  stripeChargeId        String?
  stripeRefundId        String?
  walletTransactionId   String?
  giftCardId            String?
  contactPaymentMethodId String?
  reference   String?
  notes       String?
  paidAt      DateTime?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactPaymentMethod ContactPaymentMethod? @relation(fields: [contactPaymentMethodId], references: [id], onDelete: SetNull)
  walletTransactions ContactWalletTransaction[]
  giftCard           GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, invoiceId])
  @@index([businessId, contactId])
  @@index([businessId, method])
  @@index([businessId, paidAt])
  @@index([businessId, payableType, payableId])
  @@index([businessId, giftCardId])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

model PlanGroup {
  id              String          @id @default(uuid())
  name            String
  description     String?
  currency        String          @default("USD")
  status          PlanGroupStatus @default(DRAFT)
  billingCycles   Json            @default("[\"MONTHLY\",\"YEARLY\"]")
  snapshotId      String?
  defaultCtaLabel String?
  defaultCtaUrl   String?
  designSettings  Json?
  metadata        Json?
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  snapshot      Snapshot?         @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  tiers         PlanTier[]
  featureRows   PlanFeatureRow[]
  embedSettings PlanEmbedSettings?
  subscriptions BusinessSubscription[]

  @@index([status])
  @@index([deletedAt])
  @@index([snapshotId])
  @@map("plan_groups")
}

model PlanTier {
  id           String         @id @default(uuid())
  /// Optional legacy parent. New tiers are standalone (CEO model).
  planGroupId  String?
  /// Stable unique key for the sellable tier SKU (e.g. starter, growth).
  key          String?
  slug         String
  name         String
  description  String?
  status       PlanTierStatus @default(DRAFT)
  isPublic     Boolean        @default(true)
  priceMonthly Decimal?       @db.Decimal(10, 2)
  priceYearly  Decimal?       @db.Decimal(10, 2)
  setupFee     Decimal?       @db.Decimal(10, 2)
  trialDays    Int?
  /// null = unlimited
  staffLimit   Int?
  /// null = unlimited
  locationLimit Int?
  currency     String         @default("USD")
  badge        String?
  highlighted  Boolean        @default(false)
  ctaLabel     String?
  ctaUrl       String?
  sortOrder       Int            @default(0)
  designSettings  Json?
  metadata        Json?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  planGroup     PlanGroup?             @relation(fields: [planGroupId], references: [id], onDelete: SetNull)
  capabilities  PlanTierCapability[]
  features      PlanTierFeature[]
  subscriptions BusinessSubscription[]
  versions      TierVersion[]
  includedAddons TierIncludedAddon[]
  dependentAddonLinks AddonTierLink[]
  entitlementChangeCampaigns EntitlementChangeCampaign[]

  @@unique([planGroupId, slug])
  @@unique([key])
  @@index([planGroupId, sortOrder])
  @@index([status])
  @@index([isPublic])
  @@map("plan_tiers")
}

/// Immutable published snapshot of a tier (price, limits, capabilities, addon links).
model TierVersion {
  id              String   @id @default(uuid())
  tierId          String
  version         Int
  priceMonthly    Decimal? @db.Decimal(10, 2)
  priceYearly     Decimal? @db.Decimal(10, 2)
  staffLimit      Int?
  locationLimit   Int?
  /// Snapshot of capability IDs at publish time.
  capabilityIds   Json     @default("[]")
  /// Snapshot of included independent addon IDs.
  includedAddonIds Json    @default("[]")
  /// Snapshot of dependent addon IDs linked to this tier.
  dependentAddonIds Json   @default("[]")
  metadata        Json?
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  tier          PlanTier               @relation(fields: [tierId], references: [id], onDelete: Cascade)
  subscriptions BusinessSubscription[]

  @@unique([tierId, version])
  @@index([tierId])
  @@map("tier_versions")
}

model Addon {
  id                String            @id @default(uuid())
  key               String            @unique
  name              String
  description       String?
  purchaseMode      AddonPurchaseMode
  status            AddonStatus       @default(DRAFT)
  isPublic          Boolean           @default(true)
  /// Required when purchaseMode = INDEPENDENT; null for DEPENDENT.
  priceMonthly      Decimal?          @db.Decimal(10, 2)
  priceYearly       Decimal?          @db.Decimal(10, 2)
  staffLimitDelta   Int?
  locationLimitDelta Int?
  capabilityId      String
  sortOrder         Int               @default(0)
  metadata          Json?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  capability      Capability         @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  tierLinks       AddonTierLink[]
  includedInTiers TierIncludedAddon[]
  businessAddons  BusinessAddon[]
  entitlementChangeCampaigns EntitlementChangeCampaign[]

  @@index([status])
  @@index([purchaseMode])
  @@index([capabilityId])
  @@map("addons")
}

/// Dependent add-on → must link to ≥1 tier.
model AddonTierLink {
  id        String   @id @default(uuid())
  addonId   String
  tierId    String
  createdAt DateTime @default(now())

  addon Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)
  tier  PlanTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([addonId, tierId])
  @@index([tierId])
  @@map("addon_tier_links")
}

/// Independent add-on optionally included in a tier (price absorbed).
model TierIncludedAddon {
  id        String   @id @default(uuid())
  tierId    String
  addonId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tier  PlanTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  addon Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([tierId, addonId])
  @@index([addonId])
  @@map("tier_included_addons")
}

model BusinessAddon {
  id                       String              @id @default(uuid())
  businessId               String
  addonId                  String
  status                   BusinessAddonStatus @default(ACTIVE)
  source                   BusinessAddonSource
  priceAtPurchase          Decimal?            @db.Decimal(10, 2)
  billingCycle             BusinessSubscriptionBillingCycle?
  stripeSubscriptionItemId String?
  activatedAt              DateTime            @default(now())
  canceledAt               DateTime?
  metadata                 Json?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  addon    Addon    @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([businessId, addonId])
  @@index([businessId])
  @@index([addonId])
  @@index([status])
  @@index([source])
  @@map("business_addons")
}

model BusinessLocation {
  id               String                 @id @default(uuid())
  businessId       String
  name             String
  address          String?
  city             String?
  state            String?
  country          String?
  zip              String?
  timezone         String?
  status           BusinessLocationStatus @default(ACTIVE)
  isPrimary        Boolean                @default(false)
  defaultCalendarId String?
  deactivatedAt    DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, status])
  @@map("business_locations")
}

model BusinessStripeCustomer {
  id               String   @id @default(uuid())
  businessId       String   @unique
  stripeCustomerId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentMethods  BusinessPaymentMethod[]

  @@index([stripeCustomerId])
  @@map("business_stripe_customers")
}

model BusinessPaymentMethod {
