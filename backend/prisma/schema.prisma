/// Per-business feature pin used when a service is removed from a capability (grandfathering).
model BusinessFeatureGrant {
  id         String                     @id @default(uuid())
  businessId String
  featureKey String
  source     BusinessFeatureGrantSource @default(GRANDFATHERED)
  status     BusinessFeatureGrantStatus @default(ACTIVE)
  capabilityId String?
  campaignId String?
  revokedAt  DateTime?
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign EntitlementChangeCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([businessId, featureKey, source])
  @@index([businessId])
  @@index([featureKey])
  @@index([status])
  @@index([campaignId])
  @@map("business_feature_grants")
}

/// Platform ops campaign for packaging / price / capability / feature migrations.
model EntitlementChangeCampaign {
  id              String                           @id @default(uuid())
  type            EntitlementChangeCampaignType
  status          EntitlementChangeCampaignStatus  @default(OPEN)
  policy          EntitlementChangeCampaignPolicy  @default(KEEP_GRANDFATHERED)
  summary         String
  message         String?
  tierId          String?
  addonId         String?
  capabilityId    String?
  featureKeys     Json                             @default("[]")
  fromVersionId   String?
  toVersionId     String?
  /// Catalog snapshot / payload for migrate apply (prices, capability ids, etc.).
  payload         Json?
  effectiveAt     DateTime?
  autoForce       Boolean                          @default(true)
  createdByUserId String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  tier       PlanTier?  @relation(fields: [tierId], references: [id], onDelete: SetNull)
  addon      Addon?     @relation(fields: [addonId], references: [id], onDelete: SetNull)
  capability Capability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("EntitlementChangeCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members    EntitlementChangeCampaignMember[]
  featureGrants BusinessFeatureGrant[]

  @@index([type])
  @@index([status])
  @@index([tierId])
  @@index([addonId])
  @@index([capabilityId])
  @@index([effectiveAt])
  @@index([createdAt])
  @@map("entitlement_change_campaigns")
}

model EntitlementChangeCampaignMember {
  id          String                               @id @default(uuid())
  campaignId  String
  businessId  String
  included    Boolean                              @default(true)
  status      EntitlementChangeCampaignMemberStatus @default(PENDING)
  /// Per-business override of campaign effectiveAt (extensions).
  effectiveAt DateTime?
  notifiedAt  DateTime?
  migratedAt  DateTime?
  createdAt   DateTime                             @default(now())
  updatedAt   DateTime                             @updatedAt

  campaign EntitlementChangeCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  business Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([campaignId, businessId])
  @@index([campaignId])
  @@index([businessId])
  @@index([status])
  @@index([effectiveAt])
  @@map("entitlement_change_campaign_members")
}

