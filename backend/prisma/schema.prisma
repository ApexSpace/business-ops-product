model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  passwordHash             String
  firstName                String?
  lastName                 String?
  status                   UserStatus @default(ACTIVE)
  emailVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  phoneE164                String?
  phoneVerifiedAt          DateTime?
  passwordResetTokenHash   String?
  passwordResetExpiresAt   DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  platformMembership   PlatformMembership?
  businessMemberships  BusinessMembership[]
  createdBusinesses    Business[]            @relation("BusinessCreatedBy")
  auditLogs            AuditLog[]            @relation("AuditActor")
  refreshTokens        RefreshToken[]
  invitedMemberships   BusinessMembership[]  @relation("MembershipInvitedBy")
  createdContacts      Contact[]             @relation("ContactCreatedBy")
  blockedContacts      Contact[]             @relation("ContactBlockedBy")
  contactWalletTransactionsCreated ContactWalletTransaction[] @relation("ContactWalletTransactionCreatedBy")
  assignedLeads        Lead[]                @relation("LeadAssignedTo")
  createdLeads         Lead[]                @relation("LeadCreatedBy")
  assignedWorkItems    WorkItem[]            @relation("WorkItemAssignedTo")
  createdWorkItems     WorkItem[]            @relation("WorkItemCreatedBy")
  createdNotes         Note[]                @relation("NoteCreatedBy")
  assignedTasks        Task[]                @relation("TaskAssignedTo")
  createdTasks         Task[]                @relation("TaskCreatedBy")
  timeCards            TimeCard[]
  createdEstimates     Estimate[]            @relation("EstimateCreatedBy")
  createdInvoices      Invoice[]             @relation("InvoiceCreatedBy")
  closedCheckouts      Invoice[]             @relation("InvoiceClosedBy")
  invoiceItemStaff     InvoiceItem[]         @relation("InvoiceItemStaff")
  productInventoryAdjustments ProductInventoryAdjustment[] @relation("ProductInventoryAdjustmentActor")
  createdPayments      Payment[]             @relation("PaymentCreatedBy")
  calendarStaff        CalendarStaff[]
  serviceStaffAssignments ServiceStaff[]
  assignedAppointments Appointment[]         @relation("AppointmentAssignedTo")
  assignedAppointmentServiceLines AppointmentServiceLine[] @relation("AppointmentServiceLineAssignedTo")
  createdCalendars     Calendar[]            @relation("CalendarCreatedBy")
  createdAppointments  Appointment[]         @relation("AppointmentCreatedBy")
  assignedConversations Conversation[]       @relation("ConversationAssignedTo")
  conversationNotesAuthored ConversationNote[] @relation("ConversationNoteAuthor")
  uploadedFileAssets    FileAsset[]
  asyncJobs             AsyncJob[]             @relation("AsyncJobActor")
  dataImportJobs        DataImportJob[]        @relation("DataImportJobActor")
  emailTemplatesCreated EmailTemplate[]        @relation("EmailTemplateCreatedBy")
  emailTemplatesUpdated EmailTemplate[]        @relation("EmailTemplateUpdatedBy")
  whatsappMessageTemplatesCreated WhatsAppMessageTemplate[] @relation("WhatsAppTemplateCreatedBy")
  socialPostsCreated              SocialPost[]              @relation("SocialPostCreatedBy")
  automationWorkflowsCreated     AutomationWorkflow[]      @relation("AutomationWorkflowCreatedBy")
  snapshotsCreated      Snapshot[]              @relation("SnapshotCreatedBy")
  snapshotsUpdated      Snapshot[]              @relation("SnapshotUpdatedBy")
  subscriptionEventsCreated BusinessSubscriptionEvent[] @relation("SubscriptionEventCreatedBy")
  subscriptionPaymentsCreated BusinessSubscriptionPayment[] @relation("SubscriptionPaymentCreatedBy")
  businessStatusLogsChanged BusinessStatusLog[] @relation("BusinessStatusLogChangedBy")
  staffWorkSchedules          StaffWorkSchedule[]           @relation("StaffWorkScheduleUser")
  staffWorkExceptions         StaffWorkException[]          @relation("StaffWorkExceptionUser")
  staffCompensationSettings   StaffCompensationSettings[]
  bookingWaitlistEntries      BookingWaitlistEntry[]        @relation("BookingWaitlistStaff")
  entitlementChangeCampaignsCreated EntitlementChangeCampaign[] @relation("EntitlementChangeCampaignCreatedBy")

  @@unique([phoneE164])
  @@index([passwordResetTokenHash])
  @@map("users")
}

model PlatformMembership {
  id        String             @id @default(uuid())
  userId    String             @unique
  role      PlatformMemberRole
  deletedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_memberships")
}

model TrialSignupSession {
  id              String    @id @default(uuid())
  payload         Json      @default("{}")
  phoneVerifiedAt DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([expiresAt])
  @@map("trial_signup_sessions")
}

model Industry {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  description      String?
  labels           Json
  pipelineTemplate Json
  status           IndustryStatus @default(ACTIVE)
  sortOrder        Int            @default(0)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  businesses Business[]

  @@map("industries")
}

model Snapshot {
  id              String         @id @default(uuid())
  name            String
  description     String?
  status          SnapshotStatus @default(DRAFT)
  assets          Json
  publishedAt     DateTime?
  createdByUserId String?
  updatedByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy User? @relation("SnapshotCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("SnapshotUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  businesses  Business[]
  provisions  SnapshotProvision[]
  planGroups  PlanGroup[]

  @@map("snapshots")
}

model SnapshotProvision {
  id         String   @id @default(uuid())
  businessId String
  snapshotId String
  assetType  String
  sourceKey  String
  entityId   String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshot Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([businessId, snapshotId, sourceKey])
  @@index([businessId])
  @@map("snapshot_provisions")
}

