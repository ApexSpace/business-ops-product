  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("membership_settings")
}

// ─── OFFERS ──────────────────────────────────────────────────────────────────

enum OfferApplicationMode {
  STAFF_ONLY
  OFFER_CODE
  AUTOMATICALLY
}

enum OfferMembershipScope {
  ANY
  SPECIFIC
}

enum DiscountAppliesTo {
  SERVICES
  PRODUCTS
  ENTIRE_SALE
}

enum DiscountAmountType {
  PERCENTAGE
  FIXED
}

enum DiscountScope {
  ALL
  SPECIFIC
}

enum CustomFeeApplicationScope {
  ENTIRE_SALE
  PAYMENT_METHOD
}

enum CustomFeeAmountType {
  FIXED
  PERCENTAGE
}

model Offer {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  sortOrder   Int      @default(0)

  applicationMode OfferApplicationMode @default(STAFF_ONLY)
  offerCode       String?

  autoApptDateEnabled    Boolean @default(false)
  autoApptDateRules      Json?
  autoBookingDateEnabled Boolean @default(false)
  autoBookingDateRules   Json?
  autoSaleDateEnabled    Boolean @default(false)
  autoSaleDateRules      Json?

  minAmountEnabled Boolean  @default(false)
  minAmount        Decimal? @db.Decimal(10, 2)

  oncePerClient  Boolean @default(false)
  newClientsOnly Boolean @default(false)

  membershipRequired        Boolean              @default(false)
  membershipScope           OfferMembershipScope?
  specificMembershipPlanIds Json?

  specificProvidersEnabled Boolean @default(false)
  specificProviderIds      Json?

  commissionBasis MembershipCommissionBasis @default(REGULAR_PRICE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  discounts  OfferDiscount[]
  usageLog   OfferUsageLog[]

  @@index([businessId])
  @@index([businessId, isEnabled])
  @@index([businessId, offerCode])
  @@map("offers")
}

model OfferDiscount {
  id      String @id @default(uuid())
  offerId String

  appliesTo  DiscountAppliesTo
  amountType DiscountAmountType
  amount     Decimal @db.Decimal(10, 2)

  serviceScope DiscountScope @default(ALL)
  productScope DiscountScope @default(ALL)

  specificServiceCategoryIds Json?
  specificServiceIds         Json?
  specificProductCategoryIds Json?
  specificProductIds         Json?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@map("offer_discounts")
}

model OfferUsageLog {
  id              String   @id @default(uuid())
  offerId         String
  businessId      String
  contactId       String?
  saleId          String?
  discountAmount  Decimal? @db.Decimal(10, 2)
  offerCodeUsed   String?
  usedAt          DateTime @default(now())

  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([businessId])
  @@index([contactId])
  @@index([saleId])
  @@index([businessId, usedAt])
  @@map("offer_usage_logs")
}

model CustomFee {
  id               String                    @id @default(uuid())
  businessId       String
  name             String
  applicationScope CustomFeeApplicationScope
  paymentMethods   PaymentMethod[]
  amountType       CustomFeeAmountType
  amount           Decimal                   @db.Decimal(12, 2)
  isEnabled        Boolean                   @default(true)
  sortOrder        Int                       @default(0)
  deletedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, isEnabled])
  @@index([businessId, deletedAt])
  @@map("custom_fees")
}

model BusinessCheckoutAdvancedSettings {
  id         String @id @default(uuid())
  businessId String @unique

  customPaymentMethodNames String[] @default([])

  tipButtonPercents      Int[]   @default([18, 20, 22])
  hideTipButtons         Boolean @default(false)
  askClientsForTip       Boolean @default(true)
  askForTipProductsOnly  Boolean @default(false)

  askClientsForSignature Boolean @default(false)
  enableCheckPayments    Boolean @default(false)
  showChangeCalculator   Boolean @default(false)
  showReceiptPreview     Boolean @default(false)

  requireStaffForServices  Boolean @default(false)
  requireStaffForProducts  Boolean @default(false)
  requireStaffForGiftCards Boolean @default(false)
  requireStaffForPackages  Boolean @default(false)

  showServiceProviderOnReceipt Boolean @default(true)
  receiptCustomFooterText      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_checkout_advanced_settings")
}

