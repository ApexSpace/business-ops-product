### Frontend image — COPY paths assume the Docker context is the monorepo root.
###
### Dokploy (production frontend app):
###   GitHub Build Path: leave EMPTY (do not set "/". Node path.join treats "/" as
###     filesystem root and looks for /Dockerfile.frontend, which is the 2-byte miss.)
###   Docker File: Dockerfile.frontend
###   Docker Context Path: .
###   Docker Build Stage: runtime
###
### If GitHub Build Path is "frontend", Dokploy loads frontend/Dockerfile.frontend
### instead. Still set Docker Context Path to "." so COPY frontend/... sees the repo root.
FROM node:22.13-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY frontend/package.json ./frontend/
COPY packages/api-contract/package.json ./packages/api-contract/
RUN npm ci

COPY frontend ./frontend
COPY packages/api-contract ./packages/api-contract

WORKDIR /app/frontend
RUN npm run build

### Runtime stage (Next.js standalone)
FROM node:22.13-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=build /app/frontend/.next/standalone ./
COPY --from=build /app/frontend/.next/static ./frontend/.next/static
COPY --from=build /app/frontend/public ./frontend/public

EXPOSE 3000
CMD ["node", "frontend/server.js"]
